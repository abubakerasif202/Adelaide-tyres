# Adelaide Wholesale Tyres — server-only configuration.
# Copy to .env.local and fill with real values. Never prefix any of these with NEXT_PUBLIC_.

# Enquiry / quote form delivery (Resend). Leave unset in development to use the
# no-op logging transport (submissions are validated and logged, not emailed).
RESEND_API_KEY=
ENQUIRY_TO_EMAIL=
ENQUIRY_FROM_EMAIL=

# Payment provider (Stripe). Unset = development/test checkout (no charge, no card capture).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Public site URL used for canonical tags, sitemap and structured data.
NEXT_PUBLIC_SITE_URL=https://adelaidewholesaletyres.com.au

# Public business contact details. These render in the UI, so NEXT_PUBLIC_ is intentional.
# Leave blank to hide the phone/email affordances rather than show placeholder data.
NEXT_PUBLIC_BUSINESS_PHONE=
NEXT_PUBLIC_BUSINESS_EMAIL=

# 247 Truck Tyre Services inventory integration. Server-only; never use a
# NEXT_PUBLIC_ prefix. Location ID must be the configured sellable 247 location.
INVENTORY_API_URL=
INVENTORY_CLIENT_ID=
INVENTORY_CLIENT_SECRET=
INVENTORY_LOCATION_ID=

# LOCAL cross-system testing only (tests/cross-system). Each of these is ignored
# unless it points at a loopback host, so none of them can redirect production.
# INVENTORY_ALLOW_INSECURE_LOOPBACK=true   allow http://127.0.0.1 for INVENTORY_API_URL
# STRIPE_API_BASE=http://127.0.0.1:3103    Stripe API stand-in
# NOTIFY_API_BASE=http://127.0.0.1:3103    notification transport stand-in
